#!/bin/sh
# The push gate (2026-09-01): a push runs scripts/preflight_push.py and is
# refused when it fails. Installed after two pushes went out on a failed
# gate because an ad-hoc shell chain checked `tail`'s exit code instead of
# the gate's. Versioned here since 2026-10-01 so a cloud session gets it
# too (`git config core.hooksPath .githooks`, done by scripts/cloud_setup.sh).
#
# The gate needs Python 3.12, the worker's version: the Windows launcher
# locally, the setup script's .venv in the cloud.
cd "$(git rev-parse --show-toplevel)" || exit 1
if command -v py >/dev/null 2>&1; then
  PY="py -3.12"
elif [ -x .venv/bin/python ]; then
  PY=".venv/bin/python"
elif command -v python3.12 >/dev/null 2>&1; then
  PY="python3.12"
else
  PY="python3"
  echo "pre-push: no Python 3.12 found; run 'sh scripts/cloud_setup.sh' first (the gate requires 3.12)" >&2
fi
PYTHONIOENCODING=utf-8 $PY scripts/preflight_push.py
rc=$?
if [ "$rc" -ne 0 ]; then
  echo "pre-push: gate failed (exit $rc) -- push refused" >&2
  exit 1
fi
