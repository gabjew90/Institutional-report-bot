# Dropbox API
DROPBOX_APP_KEY=your_app_key
DROPBOX_APP_SECRET=your_app_secret
DROPBOX_REFRESH_TOKEN=your_refresh_token
DROPBOX_FOLDER_PATH=/InstitutionalResearch

# Google Gemini API
GOOGLE_API_KEY=your_google_api_key
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TRIAGE_MODEL=gemini-3.1-flash-lite
GEMINI_MAX_TOKENS=4096
GEMINI_MAX_CONCURRENT=5

# Discord
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_CHANNEL_ID=your_channel_id

# Scheduling (US Eastern)
TIMEZONE=America/New_York
MORNING_PULSE_HOUR=8
MORNING_PULSE_MINUTE=30
AFTERNOON_PULSE_HOUR=15
AFTERNOON_PULSE_MINUTE=0
DROPBOX_POLL_INTERVAL_MINUTES=15
PROCESS_INTERVAL_MINUTES=5

# Processing
MAX_PAGES_PER_PDF=8
IMAGE_DPI=200
MAX_RETRY_COUNT=3
PDF_DOWNLOAD_DIR=data/pdfs
DB_PATH=data/reports.db

# Logging
LOG_LEVEL=INFO
