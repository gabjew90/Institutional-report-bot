# Economic prints posted at release (report/print_watch.py, 2026-09-11).
# Empty = post to REMINDER_CHANNEL_ID; the watch is off when both are empty.
# PRINT_ALERT_CHANNEL_ID=
# Optional. Free at https://data.bls.gov/registrationEngine/ : 500 requests/day
# instead of 25, which lets the watch poll every 10 s instead of 30.
# BLS_API_KEY=

# X (Twitter) auto-post of the omni-calendar (report/x_client.py, 2026-09-11).
# Four keys from developer.x.com for the posting account, OAuth 1.0a with
# app permission "Read and Write" (regenerate the access token AFTER setting
# the permission). Nothing is sent until X_POST_ENABLED=true.
# X_API_KEY=
# X_API_SECRET=
# X_ACCESS_TOKEN=
# X_ACCESS_SECRET=
# X_POST_ENABLED=false
